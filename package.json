{
  "name": "hobbymaxx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "bun run build:server && bun run --filter @hobbymaxx/web build",
    "build:server": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json && bun run --filter @hobbymaxx/web typecheck",
    "dev": "bun run build:server && node scripts/local.mjs --watch",
    "dev:web": "bun run --filter @hobbymaxx/web dev",
    "start": "bun run build:server && node scripts/local.mjs",
    "start:api": "node apps/server/dist/index.js",
    "test": "bun run build:server && tsx --test apps/server/test/*.test.ts apps/web/test/*.test.ts",
    "benchmark": "bun run build:server && tsx scripts/benchmark.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
