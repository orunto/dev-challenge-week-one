{
  "name": "hobbymaxx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "dev": "npm run build && npm run dev --workspace @hobbymaxx/server",
    "start": "node apps/server/dist/index.js",
    "test": "npm run build && tsx --test apps/server/test/*.test.ts",
    "benchmark": "npm run build && tsx scripts/benchmark.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
