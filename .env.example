# Copy to .env. bun run start loads it; environment variables take precedence.
PORT=3000
HOST=127.0.0.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
MODEL_DIGEST=97558784bdc9175075a72655bf360b15da17df6b3b9e5182af9f8c0c8e58ba7c
MODEL_CONTEXT=4096
MODEL_MAX_OUTPUT=512
MODEL_THREADS=1
INFERENCE_TIMEOUT_MS=120000
QUEUE_TIMEOUT_MS=30000
MAX_QUEUED_REQUESTS=3
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=3600000
# Conservative UTF-8 byte allowance for user input; avoids silent context truncation.
MAX_INPUT_BYTES=1000
